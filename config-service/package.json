{
  "name": "config-service",
  "version": "1.0.0",
  "description": "Runtime configuration service for distributed microservices with Kafka notifications.",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "lint": "eslint src/",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "test:coverage": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage --coverageDirectory=tests/coverage"
  },
  "keywords": [
    "config",
    "microservice",
    "postgresql",
    "kafka",
    "express"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@opentelemetry/auto-instrumentations-node": "^0.76.0",
    "@opentelemetry/exporter-jaeger": "^2.7.1",
    "@opentelemetry/sdk-node": "^0.218.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.4",
    "kafkajs": "^2.2.4",
    "pg": "^8.11.2",
    "prom-client": "^14.0.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^4.6.3",
    "uuid": "^9.0.1",
    "winston": "^3.9.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.4"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": ["src/**/*.js"],
    "coverageReporters": ["text", "lcov", "html"]
  }
}
