{
  "name": "feature-flag-service",
  "version": "1.0.0",
  "description": "Feature flag management service with Kafka event publishing.",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "migrate": "node src/db/migrations.js",
    "lint": "npx eslint src/",
    "test": "jest --runInBand",
    "test:coverage": "jest --coverage --coverageDirectory=tests/coverage"
  },
  "dependencies": {
    "@opentelemetry/auto-instrumentations-node": "^0.76.0",
    "@opentelemetry/exporter-jaeger": "^2.7.1",
    "@opentelemetry/sdk-node": "^0.218.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "kafkajs": "^2.2.0",
    "pg": "^8.11.2",
    "prom-client": "^14.0.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^9.0.0",
    "winston": "^3.10.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "nodemon": "^2.0.22",
    "supertest": "^6.3.3"
  },
  "jest": {
    "collectCoverageFrom": ["src/**/*.js"],
    "coverageReporters": ["text", "lcov", "html"]
  }
}
